<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.androidstudio.mcpserver.AndroidStudioMCPServer</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>AndroidStudioMCPServer</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.yourcompany.com">YourCompany</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Enter short description for your plugin here.<br>
        <em>most HTML tags may be used</em>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- P0 MVP Tools -->
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.ResolveSymbolTool"/>
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.FindReferencesTool"/>
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.GetScopeTool"/>
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.CheckpointTool"/>
        <!-- P1 Tools -->
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.RefactorTool"/>
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.QueryProjectTool"/>
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.QueryFrameworkTool"/>
        <!-- P2 Tools -->
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.AnalyzeDataFlowTool"/>
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.CheckRulesTool"/>
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.StructuralSearchTool"/>
        <!-- P3 Tools -->
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.AnalyzeQualityTool"/>
        <mcpServerTool implementation="com.androidstudio.mcpserver.tools.SandboxTool"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true" />
    </extensions>
</idea-plugin>