<idea-plugin>
    <id>com.androidstudio.mcpserver.AndroidStudioMCPServer</id>
    <name>Android Studio PSI Tools (MCP)</name>
    <vendor url="https://github.com/phodal">phodal</vendor>

    <description><![CDATA[
        12 PSI-based code intelligence tools for AI agents via MCP protocol.
        Provides symbol resolution, reference finding, refactoring, project analysis,
        framework views, data flow analysis, quality metrics, and more.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
            serviceImplementation="com.androidstudio.mcpserver.server.McpServerManager"/>
        <postStartupActivity
            implementation="com.androidstudio.mcpserver.server.McpServerStartupActivity"/>
        <toolWindow id="MCP PSI Tools"
                    anchor="bottom"
                    secondary="true"
                    icon="AllIcons.Toolwindows.WebToolWindow"
                    factoryClass="com.androidstudio.mcpserver.server.McpToolWindowFactory"/>
        <notificationGroup id="MCP PSI Tools"
                           displayType="BALLOON"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true" />
    </extensions>
</idea-plugin>